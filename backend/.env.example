# ==============================================================================
# PSYGMA BACKEND SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=127.0.0.1
NODE_ENV=development

# Database Settings (MongoDB)
# If omitted or unavailable, Psygma uses isolated in-memory state storage.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=psygma_wellness

# JWT Session Security
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# TinyFish External Sanctuary Discovery API
# Optional: Leave blank to use verified curated sanctuary fallback inventory.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://api.tinyfish.wellness/v1
