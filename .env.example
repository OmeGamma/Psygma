# ==============================================================================
# PSYGMA WELLNESS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (in the project root or backend directory) for active use.
# NEVER commit your active .env file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# Server listening port
PORT=8000
# Server host binding (use 127.0.0.1 for local dev, 0.0.0.0 for containerized)
HOST=127.0.0.1
# Environment stage: development | staging | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. mongodb://localhost:27017 or mongodb+srv://<user>:<password>@cluster.mongodb.net)
# Note: If MongoDB is unavailable or omitted, Psygma automatically falls back
# to isolated, in-memory state storage with seeded demo data.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=psygma_wellness

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# High-entropy secret key for signing user session JWT tokens (minimum 32 characters)
JWT_SECRET=psygma_production_secure_jwt_secret_key_2026_omegamma_wellness_ai_64char
# Access token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. EXTERNAL WELLNESS PARTNER APIS (TINYFISH SANCTUARY DISCOVERY)
# ------------------------------------------------------------------------------
# TinyFish External Sanctuary Discovery API Key (Server-side only; never expose to client)
# If left empty, Psygma uses verified curated sanctuary fallback inventory.
TINYFISH_API_KEY=
# TinyFish API base URL
TINYFISH_BASE_URL=https://api.tinyfish.wellness/v1

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT CONFIGURATION (VITE)
# ------------------------------------------------------------------------------
# Base URL for API calls from the React frontend.
# - Leave blank/empty during local development to use the Vite proxy (/api -> http://127.0.0.1:8000)
# - Set to full URL (e.g. http://localhost:8000 or https://api.yourdomain.com) for direct or production connections.
VITE_API_BASE_URL=

# Application metadata & feature flags
VITE_APP_NAME="Psygma • AI Stress Intelligence"
VITE_TINYFISH_SANCTUARY_ENABLED=true
